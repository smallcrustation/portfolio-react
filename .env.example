# Copy to `.env` or `.env.local` and adjust. Vite only exposes variables prefixed with VITE_.

# Browser tab title and optional hero copy
# VITE_APP_TITLE=Cody - Coder
# VITE_HERO_HEADLINE=Hi, I'm Cody the Coder

# Meta / SEO (used by shared `env` helper where applicable)
# VITE_APP_DESCRIPTION=Portfolio — full stack JavaScript developer

# Contact & social (must be valid http(s) URLs where noted)
# VITE_CONTACT_EMAIL=you@example.com
# VITE_GITHUB_URL=https://github.com/yourusername
# VITE_LINKEDIN_URL=https://www.linkedin.com/in/yourprofile
